# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# In Google AI Studio / Cloud Run, this is automatically injected via the Secrets panel.
# When deploying elsewhere, set GEMINI_API_KEY in your server-side environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
