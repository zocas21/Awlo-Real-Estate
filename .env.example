# OPENAI_API_KEY: Required for ChatGPT / OpenAI API calls.
# Configure this in your environment or Secrets panel in production.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GEMINI_API_KEY: Legacy key (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
